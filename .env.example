# MongoDB Atlas Connection String
# Replace with your actual connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/lead-website?retryWrites=true&w=majority

# Payload Secret (32+ random characters)
# Generate at: https://www.random.org/strings/
PAYLOAD_SECRET=your-random-secret-key-minimum-32-characters-long

# Public URL (update after deployment)
NEXT_PUBLIC_SERVER_URL=https://your-domain.vercel.app
